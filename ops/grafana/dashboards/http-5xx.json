      "id": 1,
      "title": "Theo dõi Lỗi Máy Chủ (HTTP 5xx)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "Tổng số lỗi 5xx gần đây",
      "type": "stat",
      "targets": [
        { "expr": "sum(increase(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "Lỗi 5xx (5 phút)" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 1 },
      "id": 3,
      "title": "Tỷ lệ lỗi 5xx trên tổng lượt gọi (%)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "Tỷ lệ 5xx" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "id": 4,
      "title": "Tần suất lỗi 5xx theo từng Route (URI)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (uri, status)", "legendFormat": "{{status}} - {{uri}}" }
      ]
    }
  ],
