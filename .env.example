# =========================================
# =======================================================
# ================================================
# =======================================================
# SUPABASE CONFIGURATION (TEMPLATE)
# ================================================
# =======================================================
SUPABASE_PROJECT_ID=ijtcqjsftodfiexvximm
SUPABASE_REGION=ap-northeast-1
SUPABASE_URL=https://ijtcqjsftodfiexvximm.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWKS_URI=https://ijtcqjsftodfiexvximm.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://ijtcqjsftodfiexvximm.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=private-files
STORAGE_MAX_FILE_SIZE_BYTES=10485760
STORAGE_MAX_REQUEST_SIZE_BYTES=67108864
STORAGE_SIGNED_URL_TTL_SECONDS=600
TENANT_DATA_KEY_ID=v1
# Generate each key separately: openssl rand -base64 32
TENANT_DATA_ENCRYPTION_KEY=base64_encoded_32_byte_key
TENANT_DATA_HMAC_KEY=base64_encoded_32_byte_key

# ================================================
# =======================================================
# POSTGRESQL JDBC (SPRING BOOT & FLYWAY)
# ================================================
# =======================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://db.ijtcqjsftodfiexvximm.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_actual_db_password_here

# =======================================================
# REDIS (SESSION STORE CHO UI)
# =======================================================
# Render Key Value: dùng Internal Key Value URL (redis://...); nhà cung cấp ngoài có TLS dùng rediss://
REDIS_URL=redis://red-your-instance-id:6379

# ================================================
# =======================================================
# SEPAY (WEBHOOK + TÀI KHOẢN NHẬN TIỀN)
# ================================================
# =======================================================
# Bắt buộc ở prod: thiếu key thì webhook bị từ chối (401)
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key
# Mã ngân hàng theo SePay QR, ví dụ MBBank / Vietcombank
SEPAY_BANK_CODE=MBBank
SEPAY_BANK_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_BANK_ACCOUNT_NAME=YOUR ACCOUNT HOLDER NAME

# SePay Sandbox checkout/IPN (để false nếu chỉ nhận chuyển khoản thật qua QR)
SEPAY_SANDBOX_CHECKOUT_ENABLED=false
# Pool kết nối Hikari (Supabase giới hạn số kết nối đồng thời của project)
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
# Nút "Bỏ qua bước này" ở biên bản check-in/check-out (chỉ bật khi demo)
HANDOVER_SKIP_ENABLED=false
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_PUBLIC_BASE_URL=

# ================================================
# =======================================================
# THÔNG BÁO (#86)
# ================================================
# =======================================================
# Job 07:00 hằng ngày (giờ VN) và khi khởi động: nhắc người thuê hóa đơn sắp đến hạn
INVOICE_DUE_REMINDER_ENABLED=true
# Nhắc trước hạn thanh toán bao nhiêu ngày (tính cả ngày đến hạn)
INVOICE_DUE_REMINDER_DAYS=3

# =======================================================
# HỢP ĐỒNG (#87)
# ================================================
# =======================================================
# Job 00:15 hằng ngày (giờ VN): chuyển hợp đồng quá hạn sang EXPIRED và nhắc trước hạn
CONTRACT_EXPIRY_JOB_ENABLED=true
# Nhắc chủ trọ/nhân viên/người thuê trước ngày kết thúc bao nhiêu ngày
CONTRACT_EXPIRY_REMINDER_DAYS=30

# =======================================================
# CACHE (#88)
# ================================================
# =======================================================
# Cache danh sách nhà trọ/phòng và dashboard owner; tự xóa khi dữ liệu đổi, TTL là lưới an toàn
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000
# SePay Gateway Sandbox checkout + IPN (không chuyển tiền thật); bật riêng khi chạy thử sandbox.
SEPAY_SANDBOX_CHECKOUT_ENABLED=false
SEPAY_MERCHANT_ID=your_sepay_sandbox_merchant_id
SEPAY_SECRET_KEY=your_sepay_sandbox_secret_key
SEPAY_PUBLIC_BASE_URL=https://your-public-https-domain

# =======================================================
# GIÁM SÁT HỆ THỐNG / OBSERVABILITY (GRAFANA & OPENSEARCH)
# =======================================================
# Token bảo mật endpoint /actuator/prometheus
PHONGHUB_METRICS_TOKEN=phonghub-metrics-secret-token
# Tài khoản đăng nhập Grafana local (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Định dạng log console cấu trúc (mặc định: ecs)
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
