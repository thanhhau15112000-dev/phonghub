# =======================================================
# SUPABASE CONFIGURATION (TEMPLATE)
# =======================================================
SUPABASE_PROJECT_ID=ijtcqjsftodfiexvximm
SUPABASE_REGION=ap-northeast-1
SUPABASE_URL=https://ijtcqjsftodfiexvximm.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =======================================================
# POSTGRESQL JDBC (SPRING BOOT & FLYWAY)
# =======================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://db.ijtcqjsftodfiexvximm.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_actual_db_password_here

# =======================================================
# SEPAY (WEBHOOK + TÀI KHOẢN NHẬN TIỀN)
# =======================================================
# Bắt buộc ở prod: thiếu key thì webhook bị từ chối (401)
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key
# Mã ngân hàng theo SePay QR, ví dụ MBBank / Vietcombank
SEPAY_BANK_CODE=MBBank
SEPAY_BANK_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_BANK_ACCOUNT_NAME=YOUR ACCOUNT HOLDER NAME
# Demo/test mode SePay: "true" hiện nút "Mô phỏng chuyển khoản" (không có tiền thật). Để false khi nhận tiền thật.
SEPAY_SIMULATION_ENABLED=false
